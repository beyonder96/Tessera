#!/bin/sh
# ==============================================================================
# Tessera Git Pre-Commit Hook
# Previne vazamento acidental de chaves de API e arquivos .env
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

echo -e "${YELLOW}🔍 [Pre-Commit] Verificando segurança e arquivos em staging...${NC}"

# 1. Verificar se algum arquivo .env real foi adicionado (permite apenas .env.example)
STAGED_ENV_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env(\..+)?$' | grep -v -E '\.env\.example$')

if [ -n "$STAGED_ENV_FILES" ]; then
    echo -e "${RED}❌ ERRO: Arquivo de variáveis de ambiente detectado na área de staging:${NC}"
    echo "$STAGED_ENV_FILES"
    echo -e "${YELLOW}Dica: Arquivos .env reais contêm segredos e nunca devem ser comitados. Remova-o com:${NC}"
    echo "  git reset HEAD .env"
    ERRORS=$((ERRORS + 1))
fi

# 2. Verificar padrões de chaves de API e tokens sensíveis no conteúdo adicionado
STAGED_DIFF=$(git diff --cached --diff-filter=ACM -U0)

# Padrão OpenRouter: sk-or-v1-
if echo "$STAGED_DIFF" | grep -E '^\+[^+]*sk-or-v1-[a-zA-Z0-9]{20,}' > /dev/null; then
    echo -e "${RED}❌ ERRO: Chave do OpenRouter (sk-or-v1-...) detectada no diff!${NC}"
    ERRORS=$((ERRORS + 1))
fi

# Padrão Google API Key: AIzaSy
if echo "$STAGED_DIFF" | grep -E '^\+[^+]*AIzaSy[a-zA-Z0-9_-]{33}' > /dev/null; then
    echo -e "${RED}❌ ERRO: Chave Google API Key (AIzaSy...) detectada no diff!${NC}"
    ERRORS=$((ERRORS + 1))
fi

# Padrão GitHub Token: ghp_
if echo "$STAGED_DIFF" | grep -E '^\+[^+]*ghp_[a-zA-Z0-9]{36}' > /dev/null; then
    echo -e "${RED}❌ ERRO: Token pessoal do GitHub (ghp_...) detectado no diff!${NC}"
    ERRORS=$((ERRORS + 1))
fi

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}🚫 Commit abortado para prevenir vazamento de credenciais.${NC}"
    echo "Use GitHub Secrets ou variáveis de ambiente locais para armazenar chaves."
    exit 1
fi

echo -e "${GREEN}✅ [Pre-Commit] Nenhuma chave ou arquivo sensível detectado.${NC}"
exit 0
